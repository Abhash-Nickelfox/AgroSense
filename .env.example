# Supabase project settings — Project Settings → API in your Supabase dashboard.
# Copy this file to .env and fill in your values. The anon key is safe to expose
# in frontend code (that's what it's for); it's Row Level Security policies on
# the table that actually control what it can do.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
